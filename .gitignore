# Python
.venv/
__pycache__/
*.pyc

# Node (dev-time only: used to generate app/static/app.css, which IS committed)
node_modules/

# Test artifacts
tests/artifacts/

# uv
.uv/

# PyInstaller output (packaging/build-linux.sh). `dist/` is the ~120MB onedir bundle and
# `build/` is PyInstaller's intermediate work directory; both are regenerated by the script.
/dist/
/build/

# The Windows VERSIONINFO resource, regenerated from app/__init__.py and app/_build_info.py on
# every build by packaging/battery_sim_version_info.py. Committing it would restate the version
# string in a file nothing validates — the drift this project's single-source rule exists to
# prevent. Note that app/_build_info.py IS committed (with placeholder values) and is therefore
# deliberately absent from this list; see its docstring for why.
/packaging/version_info.txt

# Local runtime data: SQLite DB + config.toml (installation_id, feature_interest_url).
# Anchored to the repo root so it does NOT match app/data/, which holds committed shipped
# datasets (app/data/spot_prices/*.csv — the seeded Energy-Charts spot prices — and
# app/data/spot_prices_entsoe/*.csv — the same series extracted from the ENTSO-E dumps).
/data/

# Raw ENTSO-E monthly dumps: hundreds of megabytes of every European bidding zone, of which we
# commit only the extracted NL slice (app/data/spot_prices_entsoe/, produced by
# scripts/extract_entsoe_prices.py). Re-downloadable from the ENTSO-E transparency platform.
/external_data/
